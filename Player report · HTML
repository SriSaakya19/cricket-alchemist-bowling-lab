"""
player_report.py - The Cricket Alchemist Bowling Lab

Builds the plain-language player report from the player's OWN measurements
(the 3D landmark data of the analysed clip), and a printable HTML version with
the player's name on it.

Nothing here is a fixed script: every finding is computed from the clip, carries
the player's own numbers, and is left out when the clip does not support it.
There are no legality or injury verdicts.

This module does not import Streamlit, so it can be tested on its own.
"""

from __future__ import annotations

import html
import logging
import re
from datetime import datetime
from typing import Any, Dict, List, Optional

import numpy as np
import pandas as pd

logger = logging.getLogger(__name__)

MIN_VALID_FRAMES = 8

# MediaPipe Pose landmark ids per body side
_SIDE = {
    "right": {"shoulder": 12, "elbow": 14, "wrist": 16, "hip": 24, "knee": 26, "ankle": 28},
    "left": {"shoulder": 11, "elbow": 13, "wrist": 15, "hip": 23, "knee": 25, "ankle": 27},
}

STATUS_ICON = {"steady": "✅", "look": "👀", "info": "🔹", "unknown": "❔"}
STATUS_LABEL = {
    "steady": "Looks steady",
    "look": "Worth a look",
    "info": "Good to know",
    "unknown": "Could not tell",
}

DISCLAIMER = (
    "A quick review aid from one camera, using estimated body positions. It does not "
    "judge whether an action is legal or whether you are at risk of injury. "
    "Please ask a qualified coach."
)


# --------------------------------------------------------------------------
# small maths helpers
# --------------------------------------------------------------------------
def _angle_at(a: np.ndarray, b: np.ndarray, c: np.ndarray) -> float:
    """Angle ABC at B in degrees (works for 2D or 3D points)."""
    v1, v2 = a - b, c - b
    denominator = float(np.linalg.norm(v1) * np.linalg.norm(v2))
    if not np.isfinite(denominator) or denominator < 1e-8:
        return float("nan")
    cosine = float(np.clip(np.dot(v1, v2) / denominator, -1.0, 1.0))
    return float(np.degrees(np.arccos(cosine)))


def _tilt_from_vertical(vector: np.ndarray) -> float:
    """
    Angle between a body vector and straight up, in degrees.
    World landmarks have y pointing DOWN, so 'up' is minus y.
    """
    length = float(np.linalg.norm(vector))
    if not np.isfinite(length) or length < 1e-8:
        return float("nan")
    return float(np.degrees(np.arccos(np.clip(-vector[1] / length, -1.0, 1.0))))


def _pose_array(pose_3d: List[Any], rows: int) -> np.ndarray:
    poses = np.full((rows, 33, 3), np.nan)
    for index, frame in enumerate((pose_3d or [])[:rows]):
        if frame is not None and len(frame) >= 33:
            try:
                poses[index] = np.asarray(frame, dtype=float)[:33, :3]
            except (TypeError, ValueError):
                continue
    return poses


def _smooth(poses: np.ndarray, valid: np.ndarray) -> np.ndarray:
    """3-frame running median per landmark; frames without a pose stay empty."""
    rows = poses.shape[0]
    flat = pd.DataFrame(poses.reshape(rows, -1))
    smoothed = np.array(flat.rolling(3, center=True, min_periods=1).median().to_numpy(),
                        dtype=float).reshape(rows, 33, 3)
    smoothed[~valid] = np.nan
    return smoothed


def _median_over(values: List[float]) -> float:
    values = [v for v in values if np.isfinite(v)]
    return float(np.median(values)) if values else float("nan")


# --------------------------------------------------------------------------
# the report
# --------------------------------------------------------------------------
def build_player_report(df: pd.DataFrame, pose_3d: List[Any], detection_pct: float,
                        view_info: Optional[Dict[str, Any]],
                        analysis: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """
    Returns a dict with:
      level / dot / label   how clearly the bowler could be seen
      tracked_text          one sentence with the tracked percentage
      findings              list of {status, title, text}, from this clip's data
      moments               list of {label, time, frame} to look at on the video
      check                 data-based reasons to be careful with the numbers
      disclaimer
    """
    analysis = analysis or {}
    rows = len(df)
    detected = df[df["pose_detected"]] if rows else df
    median_visible = float(detected["visible_landmarks"].median()) if len(detected) else 0.0
    detection_pct = float(detection_pct) if np.isfinite(detection_pct) else 0.0

    if detection_pct >= 70 and median_visible >= 24:
        level, dot, label = "good", "🟢", "Clear view"
    elif detection_pct >= 40:
        level, dot, label = "okay", "🟡", "Partly clear"
    else:
        level, dot, label = "low", "🔴", "Hard to see"

    view_key = view_info.get("key") if view_info else None

    report: Dict[str, Any] = {
        "level": level,
        "dot": dot,
        "label": label,
        "tracked_text": (
            f"We could track your body in {detection_pct:.0f}% of the clip "
            f"({int(median_visible)} of 33 body points clearly visible on a typical frame)."
        ),
        "findings": [],
        "moments": [],
        "check": [],
        "disclaimer": DISCLAIMER,
    }
    check: List[str] = report["check"]

    if level == "low":
        check.append(
            f"We could only track you in {detection_pct:.0f}% of the clip, so we have "
            "not described your action. Film again in good light, with a steady camera "
            "and your whole body in view."
        )
        return report

    if level == "okay":
        check.append(
            f"We lost you in about {100 - detection_pct:.0f}% of the clip, so some "
            "numbers may be missing or less reliable."
        )

    try:
        _add_movement_findings(report, df, pose_3d, view_key, view_info)
    except Exception:  # noqa: BLE001 - the report must never break the page
        logger.exception("Could not work out the movement details")
        check.append("We could not work out the movement details from this clip.")

    if view_info:
        view_text = {
            "front": "mostly from the front or from behind",
            "semi": "from a diagonal angle",
            "side": "mostly from the side",
        }.get(view_key, "")
        if view_text:
            suffix = {
                "front": " Knee and elbow bend are hard to read from here, so those "
                         "findings are marked as rough. Film from the side to see them better.",
                "semi": " A diagonal view is a mix of both, so treat the numbers as rough.",
                "side": " Shoulder and hip alignment is harder to read from the side. "
                        "Film from the front or behind to check it.",
            }[view_key]
            check.append(f"The camera saw you {view_text}." + suffix)

    if analysis.get("truncated"):
        check.append(
            f"Only the first {analysis.get('sampled_frames', rows)} sampled frames were "
            "analysed, not the whole clip."
        )

    check.append(
        "Labels such as 'worth a look' are simple rules of thumb applied to your own "
        "numbers. They are not a coaching standard."
    )
    return report


def _add_movement_findings(report: Dict[str, Any], df: pd.DataFrame, pose_3d: List[Any],
                           view_key: Optional[str], view_info: Optional[Dict[str, Any]]) -> None:
    check: List[str] = report["check"]
    findings: List[Dict[str, str]] = report["findings"]
    moments: List[Dict[str, Any]] = report["moments"]

    def add(status: str, title: str, text: str) -> None:
        findings.append({"status": status, "title": title, "text": text})

    rows = len(df)
    poses = _pose_array(pose_3d, rows)
    valid = ~np.isnan(poses[:, 0, 0])
    if int(valid.sum()) < MIN_VALID_FRAMES:
        check.append("Too few frames had usable 3D body points to describe your movement.")
        return

    smooth = _smooth(poses, valid)
    height = -smooth[:, :, 1]                      # metres above the hip, hip-centred
    times = df["time_seconds"].to_numpy(dtype=float)
    frames = df["frame"].to_numpy(dtype=float)
    step = float(np.nanmedian(np.diff(times))) if rows > 1 else 0.1
    if not np.isfinite(step) or step <= 0:
        step = 0.1

    # ---- which arm do you bowl with? the hand that rises highest above its shoulder
    rise = {}
    for side, ids in _SIDE.items():
        gap = (height[:, ids["wrist"]] - height[:, ids["shoulder"]])[valid]
        rise[side] = float(np.nanpercentile(gap, 95)) if np.isfinite(gap).any() else float("nan")
    arm_side = max(rise, key=lambda s: rise[s] if np.isfinite(rise[s]) else -9.0)
    other_side = "left" if arm_side == "right" else "right"

    if not np.isfinite(rise[arm_side]) or rise[arm_side] < 0.10:
        check.append(
            "We did not see a hand rise above its shoulder, so we could not find your "
            "release. Make sure the whole delivery is in the clip."
        )
        return
    if np.isfinite(rise[other_side]) and rise[arm_side] - rise[other_side] < 0.12:
        check.append(
            "Both hands rose to a similar height, so we could not tell which arm you bowl "
            "with. We left the arm and front-leg details out."
        )
        return

    arm, leg = _SIDE[arm_side], _SIDE[other_side]
    add("info", "Bowling arm",
        f"Your {arm_side} hand went highest, up to about {rise[arm_side] * 100:.0f} cm above "
        f"your shoulder, so we treated your {arm_side} arm as your bowling arm and your "
        f"{other_side} leg as your front leg.")

    # ---- release: the moment the bowling hand is highest
    wrist_height = np.where(valid, height[:, arm["wrist"]], np.nan)
    release = int(np.nanargmax(wrist_height))
    # the smoothing flattens the peak by up to a frame, so settle on the raw peak next to it
    raw_height = -poses[:, arm["wrist"], 1]
    nearby = [i for i in (release - 1, release, release + 1) if 0 <= i < rows and valid[i]]
    release = max(nearby, key=lambda i: raw_height[i])
    moments.append({"label": "Your release (arm at its highest)",
                    "time": float(times[release]), "frame": int(frames[release])})

    def around(index: int) -> List[int]:
        return [i for i in (index - 1, index, index + 1) if 0 <= i < rows and valid[i]]

    def bend_at(index: int, joints) -> float:
        values = []
        for i in around(index):
            a, b, c = (smooth[i, joints[0]], smooth[i, joints[1]], smooth[i, joints[2]])
            values.append(180.0 - _angle_at(a, b, c))
        return _median_over(values)

    def tilt_at(index: int, vector_of) -> float:
        return _median_over([_tilt_from_vertical(vector_of(i)) for i in around(index)])

    # ---- front foot landing: start of the last stretch with the front foot low
    ankle_height = np.where(valid, height[:, leg["ankle"]], np.nan)
    window = max(3, int(round(1.2 / step)))
    first = max(0, release - window)
    segment = ankle_height[first:release + 1]
    landing: Optional[int] = None
    if int(np.isfinite(segment).sum()) >= 3:
        low_level = float(np.nanmin(segment)) + 0.05
        run_start, misses, i = None, 0, release
        while i >= first:
            if np.isfinite(ankle_height[i]) and ankle_height[i] <= low_level:
                run_start, misses = i, 0
            elif not np.isfinite(ankle_height[i]) and misses < 1:
                misses += 1
            else:
                break
            i -= 1
        candidate = run_start if run_start is not None else first + int(np.nanargmin(segment))
        # a real landing sits strictly between the window start and the release
        if first < candidate < release:
            landing = int(candidate)
    if landing is not None:
        moments.append({"label": "Your front foot lands",
                        "time": float(times[landing]), "frame": int(frames[landing])})
        moments.sort(key=lambda item: item["time"])

    rough = view_key == "front"
    rough_note = " The camera saw you from the front, so treat this as rough." if rough else ""

    # ---- front leg
    leg_joints = (leg["hip"], leg["knee"], leg["ankle"])
    bend_release = bend_at(release, leg_joints)
    bend_landing = bend_at(landing, leg_joints) if landing is not None else float("nan")
    leg_name = f"{other_side} knee"

    if np.isfinite(bend_release):
        if np.isfinite(bend_landing):
            change = bend_release - bend_landing
            if bend_release <= 20:
                status, title = "steady", "Front leg: firm"
                text = (f"Your {leg_name} was bent about {bend_landing:.0f}° when your foot "
                        f"landed and about {bend_release:.0f}° at release. That is close to "
                        "straight, so your front leg is holding your weight firmly.")
            elif change >= 12:
                status, title = "look", "Front leg: may be giving way"
                text = (f"Your {leg_name} was bent about {bend_landing:.0f}° when your foot "
                        f"landed but about {bend_release:.0f}° at release, which is "
                        f"{change:.0f}° more. Watch this part of the video.")
            elif change <= -8:
                status, title = "steady", "Front leg: straightening"
                text = (f"Your {leg_name} went from about {bend_landing:.0f}° of bend at "
                        f"landing to about {bend_release:.0f}° at release, so it is "
                        "straightening as you bowl.")
            else:
                status, title = "info", "Front leg: holding its bend"
                text = (f"Your {leg_name} stayed at a similar bend: about "
                        f"{bend_landing:.0f}° at landing and {bend_release:.0f}° at release.")
        else:
            if bend_release <= 20:
                status, title = "steady", "Front leg: close to straight at release"
                text = f"Your {leg_name} was bent only about {bend_release:.0f}° at release."
            else:
                status, title = "info", "Front leg at release"
                text = f"Your {leg_name} was bent about {bend_release:.0f}° at release."
            text += " We could not pin down the moment your foot landed."
        if rough:
            status = "info" if status in ("steady", "look") else status
            title += " (rough)"
            text += rough_note
        text += " (0° would be completely straight.)"
        add(status, title, text)
    else:
        add("unknown", "Front leg", "We could not measure your front knee clearly in this clip.")

    # ---- bowling arm at release
    tilt_arm = tilt_at(release, lambda i: smooth[i, arm["wrist"]] - smooth[i, arm["shoulder"]])
    bend_elbow = bend_at(release, (arm["shoulder"], arm["elbow"], arm["wrist"]))
    if np.isfinite(tilt_arm):
        if tilt_arm <= 25:
            status, title = "steady", "Bowling arm: close to upright at release"
            text = (f"At release your arm was only about {tilt_arm:.0f}° away from pointing "
                    "straight up.")
        elif tilt_arm <= 50:
            status, title = "info", "Bowling arm: a little angled at release"
            text = (f"At release your arm was about {tilt_arm:.0f}° away from pointing "
                    "straight up.")
        else:
            status, title = "look", "Bowling arm: well away from upright at release"
            text = (f"At release your arm was about {tilt_arm:.0f}° away from pointing "
                    "straight up. Camera angle can exaggerate this, so check it on the video.")
        if np.isfinite(bend_elbow):
            text += f" Your elbow was bent about {bend_elbow:.0f}° at that moment."
        text += " (Camera estimate only.)"
        if rough:
            status = "info" if status in ("steady", "look") else status
            title += " (rough)"
            text += rough_note
        add(status, title, text)
    else:
        add("unknown", "Bowling arm at release",
            "We could not measure your bowling arm clearly at release.")

    # ---- upper body lean at release
    def trunk_vector(i: int) -> np.ndarray:
        shoulders = (smooth[i, _SIDE["left"]["shoulder"]] + smooth[i, _SIDE["right"]["shoulder"]]) / 2
        hips = (smooth[i, _SIDE["left"]["hip"]] + smooth[i, _SIDE["right"]["hip"]]) / 2
        return shoulders - hips

    lean = tilt_at(release, trunk_vector)
    if np.isfinite(lean):
        if lean <= 15:
            status, title = "steady", "Upper body: fairly upright"
        elif lean <= 40:
            status, title = "info", "Upper body: leaning"
        else:
            status, title = "look", "Upper body: leaning a lot"
        add(status, title,
            f"At release your upper body was tilted about {lean:.0f}° away from upright.")


# --------------------------------------------------------------------------
# name and printable report
# --------------------------------------------------------------------------
def safe_file_stem(name: str, fallback: str = "bowler") -> str:
    stem = re.sub(r"[^A-Za-z0-9_-]+", "_", (name or "").strip()).strip("_")
    return stem[:40] or fallback


def build_player_report_html(name: str, report: Dict[str, Any], clip_name: str = "",
                             generated_at: Optional[datetime] = None) -> str:
    """One self-contained, print-friendly HTML page with the player's name on it."""
    when = (generated_at or datetime.now()).strftime("%d %b %Y")
    title_name = html.escape((name or "").strip()) or "Your bowling"
    heading = (f"Bowling report for {title_name}" if (name or "").strip()
               else "Your bowling report")

    colours = {"steady": "#1B7F4B", "look": "#B26A00", "info": "#1F5FA8", "unknown": "#666666"}

    finding_rows = "".join(
        f'<div class="item" style="border-left-color:{colours.get(item["status"], "#666")}">'
        f'<div class="tag" style="color:{colours.get(item["status"], "#666")}">'
        f'{STATUS_ICON.get(item["status"], "")} {html.escape(STATUS_LABEL.get(item["status"], ""))}</div>'
        f'<div class="ititle">{html.escape(item["title"])}</div>'
        f'<div>{html.escape(item["text"])}</div></div>'
        for item in report.get("findings", [])
    ) or '<p class="muted">We could not describe your movement from this clip.</p>'

    moment_rows = "".join(
        f'<li><b>{item["time"]:.1f} s</b>: {html.escape(item["label"])}</li>'
        for item in report.get("moments", [])
    )
    moment_block = (
        f"<h2>Watch these moments on your video</h2><ul>{moment_rows}</ul>" if moment_rows else ""
    )
    check_rows = "".join(f"<li>{html.escape(text)}</li>" for text in report.get("check", []))
    clip_line = f" · Clip: {html.escape(clip_name)}" if clip_name else ""

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{heading} | The Cricket Alchemist</title>
<style>
body {{ font-family: Arial, Helvetica, sans-serif; color:#14233A; max-width: 760px;
       margin: 24px auto; padding: 0 18px; line-height: 1.5; }}
.brand {{ letter-spacing: .14em; font-size: 12px; font-weight: 700; color:#B8860B; }}
h1 {{ margin: 6px 0 2px; font-size: 28px; }}
h2 {{ margin: 24px 0 8px; font-size: 18px; border-bottom: 2px solid #E8B54F; padding-bottom: 4px; }}
.muted {{ color:#5B6B80; font-size: 13px; }}
.clarity {{ background:#F4F7FB; border:1px solid #D5DEEA; border-radius:10px; padding:12px 14px; margin:14px 0; }}
.item {{ border-left: 5px solid #666; background:#FAFBFD; padding:10px 14px; margin:10px 0; border-radius:6px; }}
.tag {{ font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }}
.ititle {{ font-size: 16px; font-weight: 700; margin: 2px 0 4px; }}
.small {{ font-size: 12px; color:#5B6B80; margin-top: 22px; border-top:1px solid #D5DEEA; padding-top:10px; }}
button {{ margin-top: 18px; padding: 10px 16px; font-weight: 700; background:#E8B54F; border:none; border-radius:8px; cursor:pointer; }}
@media print {{ button {{ display:none; }} body {{ margin: 0; }} }}
</style></head><body>
<div class="brand">THE CRICKET ALCHEMIST · BOWLING LAB</div>
<h1>{heading}</h1>
<div class="muted">{when}{clip_line}</div>
<div class="clarity"><b>{report.get("dot", "")} {html.escape(report.get("label", ""))}.</b>
{html.escape(report.get("tracked_text", ""))}</div>
<h2>Your delivery in simple words</h2>
{finding_rows}
{moment_block}
<h2>Good to keep in mind</h2>
<ul>{check_rows}</ul>
<p class="small">{html.escape(report.get("disclaimer", DISCLAIMER))}</p>
<button onclick="window.print()">Print or save as PDF</button>
</body></html>
"""
